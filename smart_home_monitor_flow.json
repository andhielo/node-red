  {
    "id": "fn_proc",
    "type": "function",
    "z": "flow_smarthome",
    "name": "Extraer y normalizar JSON",
    "func": "// ===== Smart Home Monitor: validación, extracción y normalización =====\n// Entrada : msg.payload = JSON del sensor, p.ej.\n//   {\"temperatura\":27.5,\"humedad_suelo\":43,\"gas\":180,\"intrusion\":false,\"consumo\":320}\n// Salidas : 1 Temperatura | 2 Gas | 3 Humedad suelo | 4 Estado intrusión\n//           5 Alertas (toast) | 6 Consumo | 7 Última actualización\n\nvar datos = msg.payload;\n\n// 1) Si llega como texto, convertirlo a objeto\nif (typeof datos === \"string\") {\n    try { datos = JSON.parse(datos); }\n    catch (e) { node.warn(\"JSON inválido: \" + e.message); return null; }\n}\nif (datos === null || typeof datos !== \"object\") {\n    node.warn(\"Payload vacío o no válido\");\n    return null;\n}\n\n// 2) Convertir a número de forma segura (devuelve null si no es válido)\nfunction num(v) {\n    var n = Number(v);\n    return (v === undefined || v === null || v === \"\" || !isFinite(n)) ? null : n;\n}\n\nvar temperatura = num(datos.temperatura);\nvar gas         = num(datos.gas);\nvar suelo       = num(datos.humedad_suelo);\nvar consumo     = num(datos.consumo);\nvar intrusion   = (datos.intrusion === true || datos.intrusion === 1 ||\n                   datos.intrusion === \"1\"  || datos.intrusion === \"true\");\n\n// 3) Normalizar humedad del suelo: si llega como lectura ADC (0-4095, ESP32)\n//    se convierte a porcentaje (sensor capacitivo: más valor = más seco)\nif (suelo !== null && suelo > 100) {\n    suelo = Math.round((4095 - suelo) / 4095 * 100);\n}\nif (suelo !== null) { suelo = Math.max(0, Math.min(100, suelo)); }\n\n// 4) Construir un mensaje por widget (null = no se envía nada a esa salida)\nvar mTemp  = (temperatura !== null) ? { payload: temperatura, topic: \"Temperatura\" } : null;\nvar mGas   = (gas !== null)         ? { payload: gas,         topic: \"Gas\" } : null;\nvar mSuelo = (suelo !== null)       ? { payload: suelo,       topic: \"Humedad suelo\" } : null;\nvar mCons  = (consumo !== null)     ? { payload: consumo,     topic: \"Consumo\" } : null;\n\nvar mIntr = { payload: intrusion ? \"🚨 INTRUSIÓN DETECTADA\" : \"✅ Sin intrusión\" };\n\n// 5) Alertas (solo se dispara si hay condición crítica)\nvar alertas = [];\nif (intrusion)                          alertas.push(\"Intrusión detectada en el hogar\");\nif (gas !== null && gas > 400)          alertas.push(\"Nivel de gas peligroso: \" + gas + \" ppm\");\nif (temperatura !== null && temperatura > 40) alertas.push(\"Temperatura crítica: \" + temperatura + \" °C\");\nvar mAlerta = alertas.length ? { payload: alertas.join(\" | \"), topic: \"ALERTA\" } : null;\n\nvar mHora = { payload: new Date().toLocaleTimeString(\"es-PE\") };\n\nreturn [mTemp, mGas, mSuelo, mIntr, mAlerta, mCons, mHora];",
    "outputs": 7,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 200,
    "wires": [
