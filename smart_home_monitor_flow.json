  {
    "id": "fn_sim",
    "type": "function",
    "z": "flow_smarthome",
    "name": "Generar datos aleatorios",
    "func": "// Simulador del microcontrolador (ESP32): genera datos aleatorios\nvar p = {\n    temperatura:   Math.round((22 + Math.random() * 14) * 10) / 10,\n    humedad_suelo: Math.round(Math.random() * 100),\n    gas:           Math.round(80 + Math.random() * 450),\n    intrusion:     Math.random() > 0.85,\n    consumo:       Math.round(150 + Math.random() * 600)\n};\nmsg.payload = p;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
